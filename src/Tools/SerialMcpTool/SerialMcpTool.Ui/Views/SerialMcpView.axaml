<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SerialMcpTool.Ui.ViewModels"
             x:Class="SerialMcpTool.Ui.Views.SerialMcpView">

    <UserControl.Styles>
        <!-- 方向徽标底色（Tag 绑定方向名） -->
        <Style Selector="Border.dirBadge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=AiToPort]">
            <Setter Property="Background" Value="#26107C10"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=ManualToPort]">
            <Setter Property="Background" Value="#29B25E00"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=FromPort]">
            <Setter Property="Background" Value="#260078D4"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=AiCall]">
            <Setter Property="Background" Value="#336B69D6"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=Info]">
            <Setter Property="Background" Value="#266B6B6B"/>
        </Style>
        <Style Selector="Border.dirBadge[Tag=Error]">
            <Setter Property="Background" Value="#26D13438"/>
        </Style>
        <!-- 内容着色（默认主题前景色；仅关键方向着色） -->
        <Style Selector="TextBlock.msgText[Tag=AiToPort]">
            <Setter Property="Foreground" Value="#107C10"/>
        </Style>
        <Style Selector="TextBlock.msgText[Tag=ManualToPort]">
            <Setter Property="Foreground" Value="#B25E00"/>
        </Style>
        <Style Selector="TextBlock.msgText[Tag=FromPort]">
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>
        <Style Selector="TextBlock.msgText[Tag=AiCall]">
            <Setter Property="Foreground" Value="#6B69D6"/>
        </Style>
        <Style Selector="TextBlock.msgText[Tag=Error]">
            <Setter Property="Foreground" Value="#D13438"/>
        </Style>
        <!-- MCP 服务状态着色 -->
        <Style Selector="TextBlock.mcpState[Tag=Running]">
            <Setter Property="Foreground" Value="#107C10"/>
        </Style>
        <Style Selector="TextBlock.mcpState[Tag=Stopped]">
            <Setter Property="Foreground" Value="#8A8A8A"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20,12">

        <!-- 顶部：串口设置 + MCP 服务状态 -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12,8" Margin="0,0,0,8">
            <StackPanel Spacing="6">
                <!-- 串口设置行 -->
                <Grid ColumnDefinitions="Auto,110,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
                      ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="🔌 串口配置" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PortNames}" SelectedItem="{Binding SelectedPort}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.AutomationId="combo-serport" AutomationProperties.Name="串口选择">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" AutomationProperties.Name="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="↻ 刷新" Padding="8,4"
                            Command="{Binding RefreshPortsCommand}"
                            AutomationProperties.AutomationId="btn-refreshports" AutomationProperties.Name="刷新串口列表"/>
                    <TextBlock Grid.Column="3" Text="波特率" VerticalAlignment="Center" Opacity="0.65"/>
                    <AutoCompleteBox Grid.Column="4" ItemsSource="{x:Static vm:SerialMcpViewModel.BaudRates}"
                              Text="{Binding BaudRateText}" MinimumPrefixLength="0" MinWidth="92"
                              Watermark="115200"
                              ToolTip.Tip="从列表选择或手动输入任意波特率（回车确认）。"
                              AutomationProperties.AutomationId="combo-baud" AutomationProperties.Name="波特率"/>
                    <TextBlock Grid.Column="5" Text="数据位" VerticalAlignment="Center" Opacity="0.65"/>
                    <ComboBox Grid.Column="6" ItemsSource="{x:Static vm:SerialMcpViewModel.DataBits}"
                              SelectedIndex="{Binding DataBitsIndex}" Width="64"
                              AutomationProperties.AutomationId="combo-databits" AutomationProperties.Name="数据位"/>
                    <TextBlock Grid.Column="7" Text="校验" VerticalAlignment="Center" Opacity="0.65"/>
                    <ComboBox Grid.Column="8" ItemsSource="{x:Static vm:SerialMcpViewModel.Parities}"
                              SelectedIndex="{Binding ParityIndex}" Width="92"
                              AutomationProperties.AutomationId="combo-parity" AutomationProperties.Name="校验位"/>
                    <TextBlock Grid.Column="9" Text="停止位" VerticalAlignment="Center" Opacity="0.65"/>
                    <ComboBox Grid.Column="10" ItemsSource="{x:Static vm:SerialMcpViewModel.StopBits}"
                              SelectedIndex="{Binding StopBitsIndex}" Width="66"
                              AutomationProperties.AutomationId="combo-stopbits" AutomationProperties.Name="停止位"/>                    
                    <TextBlock Grid.Column="13" Text="{Binding PortStatusText}" VerticalAlignment="Center"
                               Opacity="0.7" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="tb-portstatus" AutomationProperties.Name="串口状态"/>
                    <Button Grid.Column="14" Content="⏏ 打开串口" Classes="accent" Padding="10,4" MinWidth="84"
                            Command="{Binding OpenPortCommand}" IsVisible="{Binding !PortOpen}"
                            AutomationProperties.AutomationId="btn-openport" AutomationProperties.Name="打开串口"/>
                    <Button Grid.Column="14" Content="⏹ 关闭串口" Padding="10,4" MinWidth="84"
                            Command="{Binding ClosePortCommand}" IsVisible="{Binding PortOpen}"
                            AutomationProperties.AutomationId="btn-closeport" AutomationProperties.Name="关闭串口"/>
                    <Button Grid.Column="15" Content="手动发送" Classes="accent" Padding="10,4"
                            Command="{Binding ManualSendCommand}"
                            AutomationProperties.AutomationId="btn-manualsend" AutomationProperties.Name="手动发送"/>
                </Grid>

                <!-- MCP 服务状态行 -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="MCP 服务" VerticalAlignment="Center" Opacity="0.65"/>
                    <TextBlock Grid.Column="1" Classes="mcpState" Tag="{Binding McpStateTag}"
                               Text="{Binding McpStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="tb-mcpstate" AutomationProperties.Name="MCP服务状态"/>
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding McpUrl}" Opacity="0.75"
                               VerticalAlignment="Center" IsVisible="{Binding McpRunning}"/>
                    <Button Grid.Column="4" Content="▶ 启动服务" Classes="accent" Padding="10,4"
                            Command="{Binding StartMcpCommand}" IsVisible="{Binding !McpRunning}"
                            AutomationProperties.AutomationId="btn-mcpstart" AutomationProperties.Name="启动MCP服务"/>
                    <Button Grid.Column="5" Content="■ 停用工具" Padding="10,4"
                            Command="{Binding StopMcpCommand}" IsVisible="{Binding McpRunning}"
                            AutomationProperties.AutomationId="btn-mcpstop" AutomationProperties.Name="停止MCP服务"/>
                    <Button Grid.Column="6" Content="复制地址" Padding="10,4"
                            Command="{Binding CopyMcpUrlCommand}" IsVisible="{Binding McpRunning}"
                            AutomationProperties.AutomationId="btn-copyurl" AutomationProperties.Name="复制服务地址"/>
                    <Button Grid.Column="7" Content="⚙ 设置…" Padding="10,4"
                            Command="{Binding OpenMcpSettingsCommand}"
                            ToolTip.Tip="打开「MCP 服务」设置：服务启停/端口、AI 客户端接入授权（令牌）管理。"
                            AutomationProperties.AutomationId="btn-mcpsettings" AutomationProperties.Name="MCP服务设置"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 底部：手动发送输入 -->
        <Border DockPanel.Dock="Bottom" Classes="card" Padding="12,8" Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="手动发送" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="HEX" VerticalAlignment="Center" Opacity="0.65"
                               ToolTip.Tip="按十六进制发送（如 41 0D 0A）；关闭时按文本发送，支持 \r \n \t \xNN 转义。"/>
                    <ToggleSwitch IsChecked="{Binding ManualHex}"
                                  AutomationProperties.AutomationId="chk-manualhex" AutomationProperties.Name="HEX发送"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="附加回车" VerticalAlignment="Center" Opacity="0.65"
                               ToolTip.Tip="文本模式下发送内容末尾自动附加 \r\n（多数设备/终端需要换行才应答）；HEX 模式不附加。"/>
                    <ToggleSwitch IsChecked="{Binding AppendNewline}"
                                  AutomationProperties.AutomationId="chk-appendnl" AutomationProperties.Name="附加回车"/>
                </StackPanel>
                <TextBox Grid.Column="4" Classes="mono" Text="{Binding ManualText}" Watermark="输入要发送的内容（文本模式支持 \r \n 转义，回车发送）"
                         AutomationProperties.AutomationId="input-manualdata" AutomationProperties.Name="手动发送内容">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ManualSendCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="5" Content="发送" Classes="accent" Padding="14,4"
                        Command="{Binding ManualSendCommand}"
                        AutomationProperties.AutomationId="btn-send" AutomationProperties.Name="发送"/>
            </Grid>
        </Border>

        <!-- 主体：收发监控列表 -->
        <Border Classes="card" Padding="10,4,10,4">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10"
                      Margin="4,0,4,4">
                    <TextBlock Grid.Column="0" Text="📋 收发监控" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="HEX 显示" VerticalAlignment="Center" Opacity="0.65"
                               ToolTip.Tip="切换监控列表的数据显示格式（转义文本 / 十六进制）。"/>
                    <ToggleSwitch IsChecked="{Binding HexMode}"
                                  AutomationProperties.AutomationId="chk-hexmode" AutomationProperties.Name="HEX显示"/>
                </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="自动滚动" VerticalAlignment="Center" Opacity="0.65"/>
                    <ToggleSwitch IsChecked="{Binding AutoScroll}"
                                  AutomationProperties.AutomationId="chk-autoscroll" AutomationProperties.Name="自动滚动"/>
                </StackPanel>
                    <Button Grid.Column="3" Content="清空" Padding="10,4"
                            Command="{Binding ClearLogCommand}"
                            AutomationProperties.AutomationId="btn-clearlog" AutomationProperties.Name="清空监控"/>
                    <Button Grid.Column="4" Content="复制全部" Padding="10,4"
                            Command="{Binding CopyAllLogCommand}"
                            ToolTip.Tip="把全部监控记录（时间/方向/内容）复制到剪贴板。"
                            AutomationProperties.AutomationId="btn-copyall" AutomationProperties.Name="复制全部记录"/>

                    <TextBlock Grid.Column="6" Text="历史保留" VerticalAlignment="Center" Opacity="0.65" Width="56"
                               ToolTip.Tip="接收行历史保留条数：0 = 全部缓存（默认）；大于 0 时只保留最近 N 行。打开串口时生效，完整历史可经 MCP read_serial_data 按行号读取。"/>
                    <TextBox Grid.Column="7" Text="{Binding HistoryInput}" Width="60" Height="10"
                             ToolTip.Tip="接收行历史保留条数：0 = 全部缓存（默认）；大于 0 时只保留最近 N 行。"
                             AutomationProperties.AutomationId="input-linehistory" AutomationProperties.Name="行历史条数"/>

                    <TextBlock Grid.Column="8" Text="{Binding StatsText}" Opacity="0.6" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="tb-stats" AutomationProperties.Name="收发统计"/>
                </Grid>

                <!-- 方向过滤标签：默认全选=全部显示；只勾某几个则只显示对应方向（"全部"为全选快捷开关） -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="4,0,4,4">
                    <TextBlock Text="筛选" Opacity="0.6" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding FilterAll}" Content="全部"
                              AutomationProperties.AutomationId="chk-filter-all" AutomationProperties.Name="筛选全部"/>
                    <CheckBox IsChecked="{Binding FilterFromPort}" Content="串口返回"
                              AutomationProperties.AutomationId="chk-filter-fromport" AutomationProperties.Name="筛选串口返回"/>
                    <CheckBox IsChecked="{Binding FilterAiToPort}" Content="AI→串口"
                              AutomationProperties.AutomationId="chk-filter-ai" AutomationProperties.Name="筛选AI下发"/>
                    <CheckBox IsChecked="{Binding FilterAiCall}" Content="AI调用"
                              AutomationProperties.AutomationId="chk-filter-aicall" AutomationProperties.Name="筛选AI调用记录"/>
                    <CheckBox IsChecked="{Binding FilterManualToPort}" Content="手动→串口"
                              AutomationProperties.AutomationId="chk-filter-manual" AutomationProperties.Name="筛选手动发送"/>
                    <CheckBox IsChecked="{Binding FilterInfo}" Content="系统"
                              AutomationProperties.AutomationId="chk-filter-info" AutomationProperties.Name="筛选系统提示"/>
                    <CheckBox IsChecked="{Binding FilterError}" Content="错误"
                              AutomationProperties.AutomationId="chk-filter-error" AutomationProperties.Name="筛选错误"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="暂无收发记录——启动 MCP 服务并让 AI 客户端连接，或直接打开串口手动发送。"
                           Opacity="0.5" Margin="6,6" IsVisible="{Binding Items.Count, Converter={x:Static vm:Converters.CountIsZero}}"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding FilteredItems}"
                         SelectionMode="Multiple"
                         SelectedItems="{Binding SelectedItems}"
                         AutomationProperties.AutomationId="list-serialtraffic" AutomationProperties.Name="串口收发监控">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制选中行" Command="{Binding CopySelectedCommand}"
                                      ToolTip.Tip="复制当前选中的监控行（时间/方向/内容，制表符分隔）。"
                                      AutomationProperties.AutomationId="menu-copy-selected" AutomationProperties.Name="复制选中行"/>
                            <MenuItem Header="复制全部记录" Command="{Binding CopyAllLogCommand}"
                                      AutomationProperties.AutomationId="menu-copy-all" AutomationProperties.Name="复制全部记录"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 单排布局：时间 / 方向徽标 / 内容（超宽截断，悬停看全文；串口返回内容按 \r\n 真实换行） -->
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="1,1,3,1"
                                  AutomationProperties.Name="{Binding DisplayText}">
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="mono" Opacity="0.5" FontSize="12"
                                           VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <Border Grid.Column="1" Classes="dirBadge" Tag="{Binding Tag}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DirectionText}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="2" Classes="mono msgText" Tag="{Binding Tag}" Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                                           ToolTip.Tip="{Binding DisplayText}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
