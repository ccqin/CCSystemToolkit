<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Toolkit.App.ViewModels"
             x:Class="Toolkit.App.Views.LogsView">

    <UserControl.Styles>
        <Style Selector="TextBlock.logMsg[Tag=Success]">
            <Setter Property="Foreground" Value="#107C10"/>
        </Style>
        <Style Selector="TextBlock.logMsg[Tag=Error]">
            <Setter Property="Foreground" Value="#D13438"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24,18">
        <!-- 顶部：标题 + 统计 + 筛选 + 清空 -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="16,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="20"/>
                    <TextBlock Text="操作日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Opacity="0.6" VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <ComboBox Grid.Column="3" Width="104" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="combo-level" AutomationProperties.Name="级别筛选"
                          ItemsSource="{x:Static vm:LogsViewModel.LevelFilters}"
                          SelectedItem="{Binding LevelFilter}" ToolTip.Tip="按级别筛选日志。"/>
                <ComboBox Grid.Column="4" MinWidth="150" MaxWidth="260" Margin="8,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="combo-source" AutomationProperties.Name="来源筛选"
                          ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SourceFilter}" ToolTip.Tip="按来源（工具）筛选日志。"/>
                <Button Grid.Column="5" Content="清空" Command="{Binding ClearLogsCommand}" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="btn-clear-logs"
                        ToolTip.Tip="清空当前已归集的日志（不影响工具内部各自的日志）。"/>
            </Grid>
        </Border>

        <!-- 空态提示 -->
        <TextBlock Text="暂无日志——进入工具执行操作后，所有工具的日志会统一归集到这里。"
                   Opacity="0.5" Margin="6,16" HorizontalAlignment="Center"
                   IsVisible="{Binding View.Count, Converter={x:Static vm:Converters.CountIsZero}}"/>

        <!-- 日志列表（最新在前，与主页状态栏 Flyout 一致） -->
        <ListBox ItemsSource="{Binding View}" FontFamily="Cascadia Mono,Consolas" Background="Transparent"
                 AutomationProperties.AutomationId="list-logs" AutomationProperties.Name="日志列表">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,4"
                                AutomationProperties.AutomationId="{Binding Time, StringFormat='log-{0:HHmmss}'}"
                                AutomationProperties.Name="{Binding Message}">
                        <TextBlock Text="{Binding TimeText}" Opacity="0.55" VerticalAlignment="Center"/>
                        <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{Binding Source}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Classes="logMsg" Tag="{Binding LevelText}" Text="{Binding Message}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
