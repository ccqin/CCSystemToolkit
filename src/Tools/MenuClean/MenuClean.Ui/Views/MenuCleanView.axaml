<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MenuClean.Ui.ViewModels"
             x:Class="MenuClean.Ui.Views.MenuCleanView">

    <UserControl.Styles>
        <!-- 模拟右键菜单面板 -->
        <Style Selector="Border.menuPreview">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #33000000"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="MinWidth" Value="420"/>
        </Style>
        <Style Selector="Border.menuRow">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style Selector="Border.menuRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <!-- 菜单项文字：禁用项变灰 -->
        <Style Selector="Border.menuRow TextBlock.menuTitle">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style Selector="Border.menuRow[Tag=off] TextBlock.menuTitle">
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="TextDecorations" Value="Strikethrough"/>
        </Style>
        <Style Selector="Border.menuRow[Tag=residual] TextBlock.menuTitle">
            <Setter Property="Foreground" Value="#D13438"/>
        </Style>
        <!-- 场景侧栏项 -->
        <Style Selector="ListBoxItem.sceneItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- 来源组行 -->
        <Style Selector="Border.sourceRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="24,18">
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="16,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="🧹 清理右键菜单" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="🔍 搜索名称 / 来源 / 场景（列表页）"
                         HorizontalAlignment="Right" MinWidth="220"
                         AutomationProperties.AutomationId="tb-search" AutomationProperties.Name="搜索"/>
                <Button Grid.Column="2" Content="↻ 扫描" Classes="accent" Command="{Binding ScanCommand}" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="btn-scan" AutomationProperties.Name="扫描"/>
                <Button Grid.Column="3" Content="🧹 清理残留" Command="{Binding CleanResidualCommand}" Margin="8,0,0,0"
                        ToolTip.Tip="删除全部指向已不存在文件的菜单项（自动 .reg 备份）。"
                        AutomationProperties.AutomationId="btn-clean-residual"/>
                <Button Grid.Column="4" Content="📦 备份" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="btn-backups" AutomationProperties.Name="备份管理">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="440" Spacing="8" Margin="2,4">
                                <TextBlock Text="备份与还原" FontWeight="SemiBold"/>
                                <TextBlock Text="删除/清理操作前自动导出 .reg 备份。选中一条还原：" Opacity="0.6" FontSize="12"/>
                                <ListBox ItemsSource="{Binding Backups}" MinHeight="120" MaxHeight="260"
                                         AutomationProperties.AutomationId="list-backups">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12.5" AutomationProperties.Name="{Binding FileName}"/>
                                                    <TextBlock FontSize="11" Opacity="0.55">
                                                        <Run Text="{Binding Time}"/> · <Run Text="{Binding Size}"/> 字节
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="还原" FontSize="12" Padding="10,3"
                                                        Command="{Binding $parent[ListBox].DataContext.RestoreBackupCommand}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.AutomationId="btn-restore"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="打开备份目录…" Command="{Binding OpenBackupsCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="5" Content="以管理员重启" Command="{Binding ElevateCommand}" Margin="8,0,0,0"
                        ToolTip.Tip="删除 HKLM 下的注册键需要管理员。"
                        AutomationProperties.AutomationId="btn-elevate"/>
            </Grid>
        </Border>

        <!-- 统计卡 + Win11 提示 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*,*,*">
                    <Border Classes="card" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="全部条目" Classes="cardLabel"/><TextBlock Text="{Binding TotalCount}" Classes="cardValue"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="第三方注入" Classes="cardLabel"/><TextBlock Text="{Binding ThirdPartyCount}" Classes="cardValue"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="⚠ 残留" Classes="cardLabel"/><TextBlock Text="{Binding ResidualCount}" Classes="cardValue" Foreground="#D13438"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card" Padding="12,8">
                        <StackPanel><TextBlock Text="已禁用" Classes="cardLabel"/><TextBlock Text="{Binding DisabledCount}" Classes="cardValue"/></StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="ℹ Windows 11：本工具管理经典右键菜单（「显示更多选项」/ Shift+F10 中的项）。禁用完全可逆，删除前自动备份。"
                           Opacity="0.6" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 状态行 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Opacity="0.7" Margin="2,10,0,0"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="tb-status" AutomationProperties.Name="状态"/>

        <!-- ============ 三个 Tab 页 ============ -->
        <TabControl AutomationProperties.AutomationId="tabs-views" AutomationProperties.Name="视图页签">
            <TabItem Header="🖥 场景视图" AutomationProperties.AutomationId="tab-scene">

                <!-- 场景视图：左场景列表 + 右模拟右键菜单 -->
                <Grid ColumnDefinitions="230,*" Margin="0,10,0,0">
            <Border Classes="card" Padding="8" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}"
                         Background="Transparent" AutomationProperties.AutomationId="list-scenes" AutomationProperties.Name="场景列表">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding Label}"/>
                                <Border Grid.Column="2" CornerRadius="8" Padding="7,1" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.7"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Grid.Column="1">
                <StackPanel Grid.Column="0" Spacing="6">
                    <!-- 场景计数标题 -->
                    <TextBlock FontSize="13" Opacity="0.7"
                               AutomationProperties.AutomationId="tb-scene-count" AutomationProperties.Name="场景条目数">
                        <Run Text="当前场景："/><Run Text="{Binding SelectedScene.Label}" FontWeight="SemiBold"/>
                        <Run Text=" · 共 "/><Run Text="{Binding MenuItems.Count}" FontWeight="SemiBold"/><Run Text=" 项（点击行查看详情）"/>
                    </TextBlock>

                    <!-- 模拟菜单预览：shell 组 + 分隔 + 扩展组（条目多时内部滚动） -->
                    <Border Classes="menuPreview" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="menu-preview" AutomationProperties.Name="菜单预览">
                    <ScrollViewer MaxHeight="500">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="menuRow" Tag="{Binding BadgeText}" Tapped="OnMenuRowTapped"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.85">
                                                <TextBlock Text="{Binding FirstChar}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Classes="menuTitle" Text="{Binding Title}"/>
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10.5" Opacity="0.65" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SourceName}" FontSize="11" Opacity="0.5"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding $parent[UserControl].DataContext.ToggleEntryCommand}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.AutomationId="switch-entry" AutomationProperties.Name="{Binding Title}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 选中项详情（点击菜单行显示） -->
                <Border Grid.Column="1" Classes="card" Padding="12,10" Margin="10,0,0,0" MinWidth="280" MaxWidth="380"
                        VerticalAlignment="Top" IsVisible="{Binding HasSelectedEntry}"
                        AutomationProperties.AutomationId="panel-detail" AutomationProperties.Name="条目详情">
                    <StackPanel Spacing="6">
                        <TextBlock Text="详情" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding SelectedEntry.Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto,*" >
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,10,0">
                                <TextBlock Text="场景" Classes="cardLabel"/>
                                <TextBlock Text="类型" Classes="cardLabel"/>
                                <TextBlock Text="来源" Classes="cardLabel"/>
                                <TextBlock Text="状态" Classes="cardLabel"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding SelectedEntry.SceneLabel}"/>
                                <TextBlock Text="{Binding SelectedEntry.KindText}"/>
                                <TextBlock Text="{Binding SelectedEntry.SourceName}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedEntry.StatusText}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="注册表键" Classes="cardLabel"/>
                        <TextBlock FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Classes="mono"
                                   Text="{Binding SelectedEntry.Model.RegistryPath}"/>
                        <TextBlock Text="命令 / 目标" Classes="cardLabel"/>
                        <TextBlock FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Classes="mono"
                                   Text="{Binding SelectedEntry.Command}"/>
                        <TextBlock Text="⚠ 该项指向的文件已不存在（卸载残留），可在列表页删除"
                                   Foreground="#D13438" FontSize="12" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedEntry.IsResidual}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

            </TabItem>

            <TabItem Header="📦 来源视图" AutomationProperties.AutomationId="tab-source">
                <!-- 来源视图：按软件聚合，点击展开全部注入点 -->
                <ScrollViewer Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding SourceGroups}" Margin="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Classes="card" Padding="6,4" Margin="0,0,0,8"
                                          AutomationProperties.AutomationId="expander-source" AutomationProperties.Name="{Binding Name}">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="系统" FontSize="10.5" Opacity="0.55" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsSystem}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="全部禁用" Command="{Binding $parent[ItemsControl].DataContext.ToggleSourceCommand}"
                                                        CommandParameter="{Binding}" FontSize="12.5"
                                                        AutomationProperties.AutomationId="btn-source-disable"/>
                                                <Button Content="全部启用" Classes="accent"
                                                        Command="{Binding $parent[ItemsControl].DataContext.ToggleSourceCommand}"
                                                        CommandParameter="{Binding}" FontSize="12.5"
                                                        AutomationProperties.AutomationId="btn-source-enable"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <!-- 展开内容：该来源的全部注入点 -->
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="8,2,8,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="2*,90,60,90,Auto" Margin="2,4">
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               AutomationProperties.Name="{Binding Title}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SceneLabel}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding KindText}" VerticalAlignment="Center" Opacity="0.65" FontSize="12"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{Binding StatusText, Converter={x:Static vm:Converters.StatusBrush}}"/>
                                                    <ToggleSwitch Grid.Column="4" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                                  Command="{Binding $parent[UserControl].DataContext.ToggleEntryCommand}"
                                                                  CommandParameter="{Binding}"
                                                                  AutomationProperties.AutomationId="switch-source-entry"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </TabItem>

            <TabItem Header="📋 全量列表" AutomationProperties.AutomationId="tab-list">
                <!-- 全量列表 -->
                <DataGrid ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal" MinHeight="200" Margin="0,10,0,0"
                          AutomationProperties.AutomationId="grid-entries" AutomationProperties.Name="菜单条目表">
            <DataGrid.Columns>
                <DataGridTextColumn Header="标记" Binding="{Binding BadgeText}" Width="90"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="场景" Binding="{Binding SceneLabel}" Width="110"/>
                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="60"/>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceName}" Width="1.2*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="目标文件" Binding="{Binding TargetPath}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
