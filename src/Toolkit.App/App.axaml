<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Toolkit.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ===== 全局通用样式（工具视图共用） ===== -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Courier New"/>
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Courier New"/>
        </Style>

        <!-- ===== 统一控件圆角风格（ControlTheme 属性由样式 Setter 覆盖） ===== -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBlock.cardValue">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- ===== 主页工具卡片 ===== -->
        <Style Selector="Button.toolcard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- 悬停上浮动效（阴影由内容里的装饰 Border 提供，随变换一起移动） -->
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 卡片阴影装饰层：外扩 7px，阴影渗入部分落在卡片可视区之外 -->
        <Style Selector="Border.cardShadow">
            <Setter Property="BoxShadow" Value="0 2 8 0 #2E000000"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <!-- 卡片文字：默认主题前景色（浅色主题深字）；设置自定义背景后换白色 -->
        <Style Selector="Button.toolcard TextBlock.cardText">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.toolcard.customBg TextBlock.cardText">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- 悬停：边框高亮 + 轻微上浮（背景由 Button.Background 绑定提供，不覆盖） -->
        <Style Selector="Button.toolcard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="RenderTransform" Value="translate(0px, -3px)"/>
        </Style>
        <Style Selector="Button.toolcard.disabled">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.toolcard.disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <!-- 占位卡保持可交互（⚙ 背景设置可用），仅取消悬停高亮与动效 -->
        <Style Selector="Button.toolcard.disabled:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
        </Style>

        <!-- 卡片右上角背景设置按钮（深色半透明圆 + 细白描边，任何卡片背景下都醒目） -->
        <Style Selector="Button.cardSettings">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
            <Setter Property="Background" Value="#66000000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cardSettings:pointerover">
            <Setter Property="Background" Value="#A6000000"/>
            <Setter Property="BorderBrush" Value="#8CFFFFFF"/>
        </Style>
        <Style Selector="Button.cardSettings:pressed">
            <Setter Property="Background" Value="#CC000000"/>
        </Style>

        <!-- 背景设置 Flyout 里的色板按钮 -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4D000000"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </Application.Styles>
</Application>
