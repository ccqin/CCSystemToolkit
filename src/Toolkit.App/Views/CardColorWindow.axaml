<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Toolkit.App.Views.CardColorWindow"
        Title="自定义卡片颜色"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="18" Spacing="14">
        <TextBlock Text="为卡片选择一个背景颜色（深色背景会自动改用白色文字）" Opacity="0.65" TextWrapping="Wrap"/>
        <ColorPicker x:Name="Picker"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,2,0,0">
            <Button Content="取消" Width="88" AutomationProperties.AutomationId="btn-color-cancel" Click="OnCancel"/>
            <Button Content="确定" Width="88" Classes="accent" AutomationProperties.AutomationId="btn-color-ok" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
